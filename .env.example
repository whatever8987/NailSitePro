# Application settings
PORT=5000
NODE_ENV=development
SESSION_SECRET=your_session_secret_here

# Database settings (if using PostgreSQL instead of in-memory)
# DATABASE_URL=postgresql://username:password@localhost:5432/salonsite

# Payment providers configuration
# Set to 'true' to enable, 'false' to disable
ENABLE_STRIPE=true
ENABLE_PAYPAL=false
ENABLE_MANUAL=true

# Default payment provider (must be enabled)
# Options: 'stripe', 'paypal', 'manual'
DEFAULT_PAYMENT_PROVIDER=stripe

# Stripe configuration (required if ENABLE_STRIPE=true)
STRIPE_SECRET_KEY=sk_test_your_secret_key
VITE_STRIPE_PUBLIC_KEY=pk_test_your_public_key

# PayPal configuration (required if ENABLE_PAYPAL=true)
PAYPAL_API_KEY=your_paypal_api_key
VITE_PAYPAL_CLIENT_ID=your_paypal_client_id